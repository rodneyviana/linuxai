# linuxai configuration.
# Copy this file to .env and fill in your values. Never commit .env.

# Required: API key for the NVIDIA hosted free endpoints.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Optional overrides (defaults shown):
# LINUXAI_BASE_URL=https://integrate.api.nvidia.com/v1
# LINUXAI_MODEL=openai/gpt-oss-20b

# Point at local Ollama instead:
# LINUXAI_BASE_URL=http://localhost:11434/v1

# Optional: SearXNG host for the model-driven --web tools (needs JSON enabled
# in settings.yml). Without this value, -w/--web is unavailable. Page reading
# is also gated by --web; non-whitelisted origins require terminal approval.
# LINUXAI_SEARXNG_URL=http://localhost:8080

# Optional assistant instructions are read from:
# ~/.config/linuxai/instructions.txt
